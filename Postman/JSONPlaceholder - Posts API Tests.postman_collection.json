    {
      "name": "2. CREATE (สร้าง post)",
      "item": [
        {
          "name": "POST create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const p = pm.response.json();",
                  "pm.test('Post has required fields with correct types', () => {",
                  "  pm.expect(p).to.have.all.keys('userId','id','title','body');",
                  "  pm.expect(p.userId).to.be.a('number'); pm.expect(p.id).to.be.a('number');",
                  "  pm.expect(p.title).to.be.a('string'); pm.expect(p.body).to.be.a('string');",
                  "});",
                  "pm.test('Echoes the submitted data', () => {",
                  "  pm.expect(p.title).to.eql(pm.environment.get('newTitle'));",
                  "  pm.expect(p.body).to.eql(pm.environment.get('newBody'));",
                  "  pm.expect(p.userId).to.eql(1);",
                  "});",
                  "pm.test('Server assigns new id (101)', () => pm.expect(p.id).to.eql(101));",
                  "pm.environment.set('createdPostId', p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{newTitle}}\",\n  \"body\": \"{{newBody}}\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "หมายเหตุ: JSONPlaceholder เป็น fake API จึงไม่บันทึกข้อมูลจริง คืนค่า id=101 เสมอ"
