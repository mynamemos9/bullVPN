                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const c = pm.response.json();",
                  "pm.test('Filtered result only contains postId=1', () => { pm.expect(c.length).to.be.above(0); c.forEach(x => pm.expect(x.postId).to.eql(1)); });"
                ]
              }
