    {
      "name": "1. READ (แสดงผล posts)",
      "item": [
        {
          "name": "GET all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));\npm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));\nconst d = pm.response.json();\npm.test('Returns array of 100 posts', () => { pm.expect(d).to.be.an('array'); pm.expect(d).to.have.lengthOf(100); });\npm.test('Every post has valid schema', () => d.forEach(p => pm.expect(p).to.have.all.keys('userId','id','title','body')));\npm.test('Post ids are unique', () => pm.expect(new Set(d.map(p => p.id)).size).to.eql(d.length));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET post by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const p = pm.response.json();",
                  "pm.test('Post has required fields with correct types', () => {",
                  "  pm.expect(p).to.have.all.keys('userId','id','title','body');",
                  "  pm.expect(p.userId).to.be.a('number'); pm.expect(p.id).to.be.a('number');",
                  "  pm.expect(p.title).to.be.a('string'); pm.expect(p.body).to.be.a('string');",
                  "});",
                  "pm.test('id matches requested id', () => pm.expect(p.id).to.eql(parseInt(pm.environment.get('postId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET comments of post (nested route)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const c = pm.response.json();",
                  "pm.test('Returns non-empty array', () => { pm.expect(c).to.be.an('array'); pm.expect(c.length).to.be.above(0); });",
                  "pm.test('All comments belong to the post', () => c.forEach(x => pm.expect(x.postId).to.eql(parseInt(pm.environment.get('postId')))));",
                  "pm.test('Comment schema valid', () => c.forEach(x => { pm.expect(x).to.have.all.keys('postId','id','name','email','body'); pm.expect(x.email).to.match(/^\\S+@\\S+\\.\\S+$/); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/comments",
              "host": [
